// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ong {
  id          String     @id @default(uuid())
  nome        String     @db.VarChar(100)
  localizacao String     @db.VarChar(100)
  
  // Relações
  animals     Animal[]
  telefones   Telefone[]
  usuarioId String? @unique
  usuario Usuario? @relation(fields:[usuarioId],references:[id])
}
enum StatusAnimal {
  DISPONIVEL       
  ADOTADO         
  EM_TRATAMENTO    
  AGUARDANDO_VISITA
}
enum SexoAnimal {
  MACHO
  FEMEA
}
model Animal {
  id           String     @id @default(uuid())
  idOng        String
  nome         String   @db.VarChar(50)
  raca         String?  @db.VarChar(60)
  sexo         SexoAnimal?
  cor          String?  @db.VarChar(50)
  idade        Int?
  temperamento String?  @db.VarChar(50)
  pelagem      String?  @db.VarChar(50)
  porte        String?  @db.VarChar(30)
  status       StatusAnimal @default(DISPONIVEL)
  // Relações
  favoritos Favorito[]
  ong          Ong      @relation(fields: [idOng], references: [id])
  interesses Interesse[]
  @@map("animais")
}

model Adotante {
  id              String      @id @default(uuid())
  nome            String      @db.VarChar(100)
  localizacao     String      @db.VarChar(100)
  dataNascimento  DateTime
  
  // Relações
  favoritos Favorito[]
  telefones       Telefone[]
  usuarioId String? @unique
  usuario Usuario? @relation(fields:[usuarioId],references:[id])
  interesses Interesse[]
}

model Telefone {
  id           String    @id @default(uuid())
  numero       String    @db.VarChar(20)
  tipoTelefone String    @default("CELULAR") @db.VarChar(20)
  
  // Chaves estrangeiras (ambas opcionais)
  idOng        String?
  idAdotante   String?
  
  // Relações
  ong          Ong?      @relation(fields: [idOng], references: [id])
  adotante     Adotante? @relation(fields: [idAdotante], references: [id])
}

enum Role{
  INSTITUICAO
  ADOTANTE
}

model Usuario {
  id              String         @id @default(uuid())
  nome            String      @db.VarChar(100)
  email           String  @unique    @db.VarChar(100)
  senha           String     
  role      Role     @default(ADOTANTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  ong Ong?
  adotante Adotante?

}

model Favorito {
  id         Int      @id @default(autoincrement())
  adotanteId String
  animalId   String
  createdAt  DateTime @default(now())

  adotante   Adotante @relation(fields: [adotanteId], references: [id], onDelete: Cascade)
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([adotanteId, animalId])
}

model Interesse{
  id Int @id @default(autoincrement())
  adotanteId String 
  animalId String 
  mensagem String?
  createdAt DateTime @default(now())
  lido Boolean @default(false)

  adotante Adotante @relation(fields:[adotanteId],references: [id],onDelete: Cascade)
  animal Animal @relation(fields: [animalId],references: [id],onDelete: Cascade)

  @@unique([adotanteId,animalId])
}
